				construct_tkn_in_place(tkns,tkn_type_elf,0);
				clr_array(string_temp);
				goto iterate_over_string_footer;
			end
			g_append_symbol(string_temp);
			construct_tkn_in_place(tkns,tkn_type_id,g_find_symbolstring_temp));
			string_temp=empty_array();
			goto iterate_over_string_footer;
	label after_iterate_over_string;
	return tkns;
end
