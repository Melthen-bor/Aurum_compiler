				goto iterate_over_string_footer;
			end
			if(cmp_str(string_temp,while_tkn_str)==0) start
				construct_tkn_in_place(tkns,tkn_type_while,0);
				clr_array(string_temp);
				goto iterate_over_string_footer;
			end
			if(cmp_str(string_temp,for_tkn_str)==0) start
				construct_tkn_in_place(tkns,tkn_type_for,0);
